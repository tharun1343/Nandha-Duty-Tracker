# Public app settings for production builds (safe to commit).
# The publishable (anon) key only allows what supabase/schema.sql's row-level security permits:
# each signed-in person can read and write only their own rows.
# Never put the secret / service_role key here — that one lives only in GitHub Secrets.
VITE_SUPABASE_URL=https://hayytgkfuzhoyjsbwhwd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_THheTKZoRbb1LD3ylG7ulw_1PuUnP1x
# In-app update check: version.json in the public "releases" storage bucket (filled by CI).
VITE_UPDATE_URL=https://hayytgkfuzhoyjsbwhwd.supabase.co/storage/v1/object/public/releases/version.json
VITE_RELEASES_URL=https://github.com/tharun1343/Nandha-Duty-Tracker/releases/latest
